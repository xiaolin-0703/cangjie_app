package ohos_app_cangjie_entry.pages

internal import ohos.base.LengthProp
import ohos.base.*
import ohos.component.*
import ohos.state_manage.*
import ohos.state_macro_manage.*
import ohos.router.*
import ohos_app_cangjie_entry.service.CircleService
import ohos_app_cangjie_entry.service.EventService

@Entry
@Component
class HomePage {
    @State var currentTab: String = "recommend"
    @State var loadingPosts: Bool = false
    @State var loadingEvents: Bool = false
    @State var firstLoaded: Bool = false
    @State var errorMsg: String = ""

    // ================= 10个帖子的变量 =================
    @State var post1Id: String = ""; @State var post1CircleId: String = ""; @State var post1CircleName: String = ""; @State var post1Title: String = ""; @State var post1Content: String = ""; @State var post1Author: String = ""; @State var post1Time: String = ""; @State var post1ImageUrl: String = ""; @State var post1LikeCount: String = "0"; @State var post1CommentCount: String = "0"
    @State var post2Id: String = ""; @State var post2CircleId: String = ""; @State var post2CircleName: String = ""; @State var post2Title: String = ""; @State var post2Content: String = ""; @State var post2Author: String = ""; @State var post2Time: String = ""; @State var post2ImageUrl: String = ""; @State var post2LikeCount: String = "0"; @State var post2CommentCount: String = "0"
    @State var post3Id: String = ""; @State var post3CircleId: String = ""; @State var post3CircleName: String = ""; @State var post3Title: String = ""; @State var post3Content: String = ""; @State var post3Author: String = ""; @State var post3Time: String = ""; @State var post3ImageUrl: String = ""; @State var post3LikeCount: String = "0"; @State var post3CommentCount: String = "0"
    @State var post4Id: String = ""; @State var post4CircleId: String = ""; @State var post4CircleName: String = ""; @State var post4Title: String = ""; @State var post4Content: String = ""; @State var post4Author: String = ""; @State var post4Time: String = ""; @State var post4ImageUrl: String = ""; @State var post4LikeCount: String = "0"; @State var post4CommentCount: String = "0"
    @State var post5Id: String = ""; @State var post5CircleId: String = ""; @State var post5CircleName: String = ""; @State var post5Title: String = ""; @State var post5Content: String = ""; @State var post5Author: String = ""; @State var post5Time: String = ""; @State var post5ImageUrl: String = ""; @State var post5LikeCount: String = "0"; @State var post5CommentCount: String = "0"
    @State var post6Id: String = ""; @State var post6CircleId: String = ""; @State var post6CircleName: String = ""; @State var post6Title: String = ""; @State var post6Content: String = ""; @State var post6Author: String = ""; @State var post6Time: String = ""; @State var post6ImageUrl: String = ""; @State var post6LikeCount: String = "0"; @State var post6CommentCount: String = "0"
    @State var post7Id: String = ""; @State var post7CircleId: String = ""; @State var post7CircleName: String = ""; @State var post7Title: String = ""; @State var post7Content: String = ""; @State var post7Author: String = ""; @State var post7Time: String = ""; @State var post7ImageUrl: String = ""; @State var post7LikeCount: String = "0"; @State var post7CommentCount: String = "0"
    @State var post8Id: String = ""; @State var post8CircleId: String = ""; @State var post8CircleName: String = ""; @State var post8Title: String = ""; @State var post8Content: String = ""; @State var post8Author: String = ""; @State var post8Time: String = ""; @State var post8ImageUrl: String = ""; @State var post8LikeCount: String = "0"; @State var post8CommentCount: String = "0"
    @State var post9Id: String = ""; @State var post9CircleId: String = ""; @State var post9CircleName: String = ""; @State var post9Title: String = ""; @State var post9Content: String = ""; @State var post9Author: String = ""; @State var post9Time: String = ""; @State var post9ImageUrl: String = ""; @State var post9LikeCount: String = "0"; @State var post9CommentCount: String = "0"
    @State var post10Id: String = ""; @State var post10CircleId: String = ""; @State var post10CircleName: String = ""; @State var post10Title: String = ""; @State var post10Content: String = ""; @State var post10Author: String = ""; @State var post10Time: String = ""; @State var post10ImageUrl: String = ""; @State var post10LikeCount: String = "0"; @State var post10CommentCount: String = "0"

    // ================= 3个活动的变量 =================
    @State var event1Id: String = ""; @State var event1Title: String = ""; @State var event1Time: String = ""; @State var event1Location: String = ""; @State var event1Status: String = ""; @State var event1Description: String = ""; @State var event1CapacityText: String = ""; @State var event1DeadlineText: String = ""; @State var event1RegisteredText: String = ""
    @State var event2Id: String = ""; @State var event2Title: String = ""; @State var event2Time: String = ""; @State var event2Location: String = ""; @State var event2Status: String = ""; @State var event2Description: String = ""; @State var event2CapacityText: String = ""; @State var event2DeadlineText: String = ""; @State var event2RegisteredText: String = ""
    @State var event3Id: String = ""; @State var event3Title: String = ""; @State var event3Time: String = ""; @State var event3Location: String = ""; @State var event3Status: String = ""; @State var event3Description: String = ""; @State var event3CapacityText: String = ""; @State var event3DeadlineText: String = ""; @State var event3RegisteredText: String = ""

    public func aboutToAppear(): Unit { if (!this.firstLoaded && !this.loadingPosts && !this.loadingEvents) { this.loadHomeData() } }
    func goToEventsPage() { Router.push(url: "EventsPage") }
    func goToCirclesPage() { Router.push(url: "CirclesPage") }
    func goToProfilePage() { Router.push(url: "ProfilePage") }
    func goToCreatePostPage() { Router.push(url: "CreatePostPage") }

    func clearPosts() {
        this.post1Id = ""; this.post1CircleId = ""; this.post1CircleName = ""; this.post1Title = ""; this.post1Content = ""; this.post1Author = ""; this.post1Time = ""; this.post1ImageUrl = ""; this.post1LikeCount = "0"; this.post1CommentCount = "0"
        this.post2Id = ""; this.post2CircleId = ""; this.post2CircleName = ""; this.post2Title = ""; this.post2Content = ""; this.post2Author = ""; this.post2Time = ""; this.post2ImageUrl = ""; this.post2LikeCount = "0"; this.post2CommentCount = "0"
        this.post3Id = ""; this.post3CircleId = ""; this.post3CircleName = ""; this.post3Title = ""; this.post3Content = ""; this.post3Author = ""; this.post3Time = ""; this.post3ImageUrl = ""; this.post3LikeCount = "0"; this.post3CommentCount = "0"
        this.post4Id = ""; this.post4CircleId = ""; this.post4CircleName = ""; this.post4Title = ""; this.post4Content = ""; this.post4Author = ""; this.post4Time = ""; this.post4ImageUrl = ""; this.post4LikeCount = "0"; this.post4CommentCount = "0"
        this.post5Id = ""; this.post5CircleId = ""; this.post5CircleName = ""; this.post5Title = ""; this.post5Content = ""; this.post5Author = ""; this.post5Time = ""; this.post5ImageUrl = ""; this.post5LikeCount = "0"; this.post5CommentCount = "0"
        this.post6Id = ""; this.post6CircleId = ""; this.post6CircleName = ""; this.post6Title = ""; this.post6Content = ""; this.post6Author = ""; this.post6Time = ""; this.post6ImageUrl = ""; this.post6LikeCount = "0"; this.post6CommentCount = "0"
        this.post7Id = ""; this.post7CircleId = ""; this.post7CircleName = ""; this.post7Title = ""; this.post7Content = ""; this.post7Author = ""; this.post7Time = ""; this.post7ImageUrl = ""; this.post7LikeCount = "0"; this.post7CommentCount = "0"
        this.post8Id = ""; this.post8CircleId = ""; this.post8CircleName = ""; this.post8Title = ""; this.post8Content = ""; this.post8Author = ""; this.post8Time = ""; this.post8ImageUrl = ""; this.post8LikeCount = "0"; this.post8CommentCount = "0"
        this.post9Id = ""; this.post9CircleId = ""; this.post9CircleName = ""; this.post9Title = ""; this.post9Content = ""; this.post9Author = ""; this.post9Time = ""; this.post9ImageUrl = ""; this.post9LikeCount = "0"; this.post9CommentCount = "0"
        this.post10Id = ""; this.post10CircleId = ""; this.post10CircleName = ""; this.post10Title = ""; this.post10Content = ""; this.post10Author = ""; this.post10Time = ""; this.post10ImageUrl = ""; this.post10LikeCount = "0"; this.post10CommentCount = "0"
    }

    func clearEvents() {
        this.event1Id = ""; this.event1Title = ""; this.event1Time = ""; this.event1Location = ""; this.event1Status = ""; this.event1Description = ""; this.event1CapacityText = ""; this.event1DeadlineText = ""; this.event1RegisteredText = ""
        this.event2Id = ""; this.event2Title = ""; this.event2Time = ""; this.event2Location = ""; this.event2Status = ""; this.event2Description = ""; this.event2CapacityText = ""; this.event2DeadlineText = ""; this.event2RegisteredText = ""
        this.event3Id = ""; this.event3Title = ""; this.event3Time = ""; this.event3Location = ""; this.event3Status = ""; this.event3Description = ""; this.event3CapacityText = ""; this.event3DeadlineText = ""; this.event3RegisteredText = ""
    }

    func hasAnyPost(): Bool { return this.post1Title != "" || this.post2Title != "" || this.post3Title != "" || this.post4Title != "" || this.post5Title != "" || this.post6Title != "" || this.post7Title != "" || this.post8Title != "" || this.post9Title != "" || this.post10Title != "" }
    func hasAnyEvent(): Bool { return this.event1Title != "" || this.event2Title != "" || this.event3Title != "" }
    func formatCapacityText(raw: String): String { return if (raw == "") { "人数待定" } else { "限 " + raw + " 人" } }
    func formatDeadlineText(raw: String): String { return if (raw == "") { "截止待定" } else { "截止：" + raw } }
    func formatRegisteredText(raw: String): String { return if (raw == "") { "报名 0 人" } else { "已报 " + raw + " 人" } }
    func cardLabelText(value: String): String { return if (value == "") { "校园动态" } else { value } }
    func normalizeStatusText(status: String): String { if (status == "published") { return "报名中" } else if (status == "finished") { return "已结束" } else if (status == "cancelled") { return "已取消" } else { return "报名中" } }

    func finishOneLoad() { if (!this.loadingPosts && !this.loadingEvents) { this.firstLoaded = true } }

    func countOrZero(raw: String): String { return if (raw == "") { "0" } else { raw } }

    func postStatsText(likeCount: String, commentCount: String): String {
        return "点赞 " + this.countOrZero(likeCount) + " · 评论 " + this.countOrZero(commentCount)
    }

    func fillPosts(raw: String) {
        this.clearPosts()
        this.post1Id = CircleService.extractPostField(raw, 0, "id"); this.post1CircleId = CircleService.extractPostField(raw, 0, "circleId"); this.post1CircleName = CircleService.extractPostField(raw, 0, "circleName"); this.post1Title = CircleService.extractPostField(raw, 0, "title"); this.post1Content = CircleService.extractPostField(raw, 0, "content"); this.post1Author = CircleService.extractPostField(raw, 0, "nickname"); this.post1Time = CircleService.extractPostField(raw, 0, "createdAt"); this.post1ImageUrl = CircleService.extractPostField(raw, 0, "imageUrl"); this.post1LikeCount = this.countOrZero(CircleService.extractPostField(raw, 0, "likeCount")); this.post1CommentCount = this.countOrZero(CircleService.extractPostField(raw, 0, "commentCount"))
        this.post2Id = CircleService.extractPostField(raw, 1, "id"); this.post2CircleId = CircleService.extractPostField(raw, 1, "circleId"); this.post2CircleName = CircleService.extractPostField(raw, 1, "circleName"); this.post2Title = CircleService.extractPostField(raw, 1, "title"); this.post2Content = CircleService.extractPostField(raw, 1, "content"); this.post2Author = CircleService.extractPostField(raw, 1, "nickname"); this.post2Time = CircleService.extractPostField(raw, 1, "createdAt"); this.post2ImageUrl = CircleService.extractPostField(raw, 1, "imageUrl"); this.post2LikeCount = this.countOrZero(CircleService.extractPostField(raw, 1, "likeCount")); this.post2CommentCount = this.countOrZero(CircleService.extractPostField(raw, 1, "commentCount"))
        this.post3Id = CircleService.extractPostField(raw, 2, "id"); this.post3CircleId = CircleService.extractPostField(raw, 2, "circleId"); this.post3CircleName = CircleService.extractPostField(raw, 2, "circleName"); this.post3Title = CircleService.extractPostField(raw, 2, "title"); this.post3Content = CircleService.extractPostField(raw, 2, "content"); this.post3Author = CircleService.extractPostField(raw, 2, "nickname"); this.post3Time = CircleService.extractPostField(raw, 2, "createdAt"); this.post3ImageUrl = CircleService.extractPostField(raw, 2, "imageUrl"); this.post3LikeCount = this.countOrZero(CircleService.extractPostField(raw, 2, "likeCount")); this.post3CommentCount = this.countOrZero(CircleService.extractPostField(raw, 2, "commentCount"))
        this.post4Id = CircleService.extractPostField(raw, 3, "id"); this.post4CircleId = CircleService.extractPostField(raw, 3, "circleId"); this.post4CircleName = CircleService.extractPostField(raw, 3, "circleName"); this.post4Title = CircleService.extractPostField(raw, 3, "title"); this.post4Content = CircleService.extractPostField(raw, 3, "content"); this.post4Author = CircleService.extractPostField(raw, 3, "nickname"); this.post4Time = CircleService.extractPostField(raw, 3, "createdAt"); this.post4ImageUrl = CircleService.extractPostField(raw, 3, "imageUrl"); this.post4LikeCount = this.countOrZero(CircleService.extractPostField(raw, 3, "likeCount")); this.post4CommentCount = this.countOrZero(CircleService.extractPostField(raw, 3, "commentCount"))
        this.post5Id = CircleService.extractPostField(raw, 4, "id"); this.post5CircleId = CircleService.extractPostField(raw, 4, "circleId"); this.post5CircleName = CircleService.extractPostField(raw, 4, "circleName"); this.post5Title = CircleService.extractPostField(raw, 4, "title"); this.post5Content = CircleService.extractPostField(raw, 4, "content"); this.post5Author = CircleService.extractPostField(raw, 4, "nickname"); this.post5Time = CircleService.extractPostField(raw, 4, "createdAt"); this.post5ImageUrl = CircleService.extractPostField(raw, 4, "imageUrl"); this.post5LikeCount = this.countOrZero(CircleService.extractPostField(raw, 4, "likeCount")); this.post5CommentCount = this.countOrZero(CircleService.extractPostField(raw, 4, "commentCount"))
        this.post6Id = CircleService.extractPostField(raw, 5, "id"); this.post6CircleId = CircleService.extractPostField(raw, 5, "circleId"); this.post6CircleName = CircleService.extractPostField(raw, 5, "circleName"); this.post6Title = CircleService.extractPostField(raw, 5, "title"); this.post6Content = CircleService.extractPostField(raw, 5, "content"); this.post6Author = CircleService.extractPostField(raw, 5, "nickname"); this.post6Time = CircleService.extractPostField(raw, 5, "createdAt"); this.post6ImageUrl = CircleService.extractPostField(raw, 5, "imageUrl"); this.post6LikeCount = this.countOrZero(CircleService.extractPostField(raw, 5, "likeCount")); this.post6CommentCount = this.countOrZero(CircleService.extractPostField(raw, 5, "commentCount"))
        this.post7Id = CircleService.extractPostField(raw, 6, "id"); this.post7CircleId = CircleService.extractPostField(raw, 6, "circleId"); this.post7CircleName = CircleService.extractPostField(raw, 6, "circleName"); this.post7Title = CircleService.extractPostField(raw, 6, "title"); this.post7Content = CircleService.extractPostField(raw, 6, "content"); this.post7Author = CircleService.extractPostField(raw, 6, "nickname"); this.post7Time = CircleService.extractPostField(raw, 6, "createdAt"); this.post7ImageUrl = CircleService.extractPostField(raw, 6, "imageUrl"); this.post7LikeCount = this.countOrZero(CircleService.extractPostField(raw, 6, "likeCount")); this.post7CommentCount = this.countOrZero(CircleService.extractPostField(raw, 6, "commentCount"))
        this.post8Id = CircleService.extractPostField(raw, 7, "id"); this.post8CircleId = CircleService.extractPostField(raw, 7, "circleId"); this.post8CircleName = CircleService.extractPostField(raw, 7, "circleName"); this.post8Title = CircleService.extractPostField(raw, 7, "title"); this.post8Content = CircleService.extractPostField(raw, 7, "content"); this.post8Author = CircleService.extractPostField(raw, 7, "nickname"); this.post8Time = CircleService.extractPostField(raw, 7, "createdAt"); this.post8ImageUrl = CircleService.extractPostField(raw, 7, "imageUrl"); this.post8LikeCount = this.countOrZero(CircleService.extractPostField(raw, 7, "likeCount")); this.post8CommentCount = this.countOrZero(CircleService.extractPostField(raw, 7, "commentCount"))
        this.post9Id = CircleService.extractPostField(raw, 8, "id"); this.post9CircleId = CircleService.extractPostField(raw, 8, "circleId"); this.post9CircleName = CircleService.extractPostField(raw, 8, "circleName"); this.post9Title = CircleService.extractPostField(raw, 8, "title"); this.post9Content = CircleService.extractPostField(raw, 8, "content"); this.post9Author = CircleService.extractPostField(raw, 8, "nickname"); this.post9Time = CircleService.extractPostField(raw, 8, "createdAt"); this.post9ImageUrl = CircleService.extractPostField(raw, 8, "imageUrl"); this.post9LikeCount = this.countOrZero(CircleService.extractPostField(raw, 8, "likeCount")); this.post9CommentCount = this.countOrZero(CircleService.extractPostField(raw, 8, "commentCount"))
        this.post10Id = CircleService.extractPostField(raw, 9, "id"); this.post10CircleId = CircleService.extractPostField(raw, 9, "circleId"); this.post10CircleName = CircleService.extractPostField(raw, 9, "circleName"); this.post10Title = CircleService.extractPostField(raw, 9, "title"); this.post10Content = CircleService.extractPostField(raw, 9, "content"); this.post10Author = CircleService.extractPostField(raw, 9, "nickname"); this.post10Time = CircleService.extractPostField(raw, 9, "createdAt"); this.post10ImageUrl = CircleService.extractPostField(raw, 9, "imageUrl"); this.post10LikeCount = this.countOrZero(CircleService.extractPostField(raw, 9, "likeCount")); this.post10CommentCount = this.countOrZero(CircleService.extractPostField(raw, 9, "commentCount"))
    }

    func fillEvents(raw: String) {
        this.clearEvents()
        this.event1Id = EventService.extractEventField(raw, 0, "id"); this.event1Title = EventService.extractEventField(raw, 0, "title"); this.event1Time = EventService.extractEventField(raw, 0, "startTimeText"); this.event1Location = EventService.extractEventField(raw, 0, "location"); this.event1Status = this.normalizeStatusText(EventService.extractEventField(raw, 0, "status")); this.event1Description = EventService.extractEventField(raw, 0, "description"); this.event1CapacityText = this.formatCapacityText(EventService.extractEventField(raw, 0, "capacity")); this.event1DeadlineText = this.formatDeadlineText(EventService.extractEventField(raw, 0, "signupDeadline")); this.event1RegisteredText = this.formatRegisteredText(EventService.extractEventField(raw, 0, "registeredCount"))
        this.event2Id = EventService.extractEventField(raw, 1, "id"); this.event2Title = EventService.extractEventField(raw, 1, "title"); this.event2Time = EventService.extractEventField(raw, 1, "startTimeText"); this.event2Location = EventService.extractEventField(raw, 1, "location"); this.event2Status = this.normalizeStatusText(EventService.extractEventField(raw, 1, "status")); this.event2Description = EventService.extractEventField(raw, 1, "description"); this.event2CapacityText = this.formatCapacityText(EventService.extractEventField(raw, 1, "capacity")); this.event2DeadlineText = this.formatDeadlineText(EventService.extractEventField(raw, 1, "signupDeadline")); this.event2RegisteredText = this.formatRegisteredText(EventService.extractEventField(raw, 1, "registeredCount"))
        this.event3Id = EventService.extractEventField(raw, 2, "id"); this.event3Title = EventService.extractEventField(raw, 2, "title"); this.event3Time = EventService.extractEventField(raw, 2, "startTimeText"); this.event3Location = EventService.extractEventField(raw, 2, "location"); this.event3Status = this.normalizeStatusText(EventService.extractEventField(raw, 2, "status")); this.event3Description = EventService.extractEventField(raw, 2, "description"); this.event3CapacityText = this.formatCapacityText(EventService.extractEventField(raw, 2, "capacity")); this.event3DeadlineText = this.formatDeadlineText(EventService.extractEventField(raw, 2, "signupDeadline")); this.event3RegisteredText = this.formatRegisteredText(EventService.extractEventField(raw, 2, "registeredCount"))
    }

    func loadHomeData() {
        this.errorMsg = ""; this.loadingPosts = true; this.loadingEvents = true
        CircleService.getLatestPosts({ raw: String => this.fillPosts(raw); this.loadingPosts = false; this.finishOneLoad() }, { msg: String => this.loadingPosts = false; this.errorMsg = msg; this.finishOneLoad() })
        EventService.getFeaturedEvents({ raw: String => this.fillEvents(raw); this.loadingEvents = false; this.finishOneLoad() }, { msg: String => this.loadingEvents = false; this.errorMsg = msg; this.finishOneLoad() })
    }

    func openCircle(circleId: String, circleName: String) { if (circleId == "") { return }; CircleService.setCurrentCircleDetail(circleId, circleName, "", "", "false"); Router.push(url: "CircleDetailPage") }
    func openEventDetail(id: String, title: String, time: String, location: String, status: String, description: String, capacityText: String, deadlineText: String) { if (id == "") { return }; EventService.setCurrentEventDetail(id, title, time, location, status, description, capacityText, deadlineText); Router.push(url: "EventDetailPage") }

    func build() {
        Column {
            Column {
                Row {
                    Row {
                        if (this.currentTab == "recommend") { Column { Text("推荐").fontColor(0xFF1D2B53).fontSize(18).fontWeight(FontWeight.Bold).padding(top: 6, bottom: 6).onClick({ _: ClickEvent => this.currentTab = "recommend" }); Row {}.width(20).height(3).backgroundColor(0xFF2F80FF).borderRadius(2) }.margin(right: 20) }
                        else { Column { Text("推荐").fontColor(0xFF74829C).fontSize(17).padding(top: 6, bottom: 6).onClick({ _: ClickEvent => this.currentTab = "recommend" }); Row {}.width(20).height(3).backgroundColor(0x00000000) }.margin(right: 20) }

                        if (this.currentTab == "latest") { Column { Text("最新").fontColor(0xFF1D2B53).fontSize(18).fontWeight(FontWeight.Bold).padding(top: 6, bottom: 6).onClick({ _: ClickEvent => this.currentTab = "latest" }); Row {}.width(20).height(3).backgroundColor(0xFF2F80FF).borderRadius(2) } }
                        else { Column { Text("最新").fontColor(0xFF74829C).fontSize(17).padding(top: 6, bottom: 6).onClick({ _: ClickEvent => this.currentTab = "latest" }); Row {}.width(20).height(3).backgroundColor(0x00000000) } }
                    }.layoutWeight(3).alignItems(VerticalAlign.Center)
                    Text("刷新").fontColor(0xFF2F80FF).fontSize(13).fontWeight(FontWeight.Bold).padding(left: 12, right: 12, top: 7, bottom: 7).backgroundColor(0xFFEAF2FF).borderRadius(14).onClick({ _: ClickEvent => this.loadHomeData() })
                }.width(100.percent).alignItems(VerticalAlign.Center)
            }.width(100.percent).padding(left: 12, right: 12, top: 10, bottom: 10).backgroundColor(0xFFFFFFFF)

            Scroll {
                Column {
                    if (this.errorMsg != "") { Column { Text("加载失败").fontSize(18).fontWeight(FontWeight.Bold).fontColor(0xFF24324A).margin(bottom: 8); Text(this.errorMsg).fontSize(13).fontColor(0xFFE96B6B) }.width(100.percent).padding(16).backgroundColor(0xFFFFFFFF).borderRadius(18).margin(bottom: 12) }
                    if ((this.loadingPosts || this.loadingEvents) && !this.firstLoaded) { Column { Text("正在加载...").fontSize(18).fontWeight(FontWeight.Bold).fontColor(0xFF24324A).margin(bottom: 8); Text("正在读取数据。").fontSize(13).fontColor(0xFF6D7B99) }.width(100.percent).padding(16).backgroundColor(0xFFFFFFFF).borderRadius(18).margin(bottom: 12) }
                    else if (!this.hasAnyPost() && !this.hasAnyEvent()) { Column { Text("还没有内容").fontSize(18).fontWeight(FontWeight.Bold).fontColor(0xFF24324A).margin(bottom: 8); Text("发帖子后会自动显示真实数据。").fontSize(13).fontColor(0xFF6D7B99).lineHeight(20) }.width(100.percent).padding(16).backgroundColor(0xFFFFFFFF).borderRadius(18).margin(bottom: 12) }
                    else if (this.currentTab == "recommend") {
                        Row {
                            Column {
                                if (this.post1Title != "") {
                                    Column {
                                        if (this.post1ImageUrl != "") { Image(this.post1ImageUrl).width(100.percent).height(190).objectFit(ImageFit.Cover).borderRadius(14).margin(bottom: 8) } else { Row { Text(this.cardLabelText(this.post1CircleName)).fontSize(17).fontWeight(FontWeight.Bold).fontColor(0xFF2F80FF) }.width(100.percent).height(190).justifyContent(FlexAlign.Center).alignItems(VerticalAlign.Center).backgroundColor(0xFFDDEBFF).borderRadius(14).margin(bottom: 8) }
                                        Text(this.post1Title).fontSize(13).fontWeight(FontWeight.Bold).fontColor(0xFF24324A).maxLines(2).textOverflow(TextOverflow.Ellipsis).margin(bottom: 8)
                                        Row { Column {}.width(16).height(16).backgroundColor(0xFFDDEBFF).borderRadius(8).margin(right: 6); Text(this.post1Author + " · " + this.cardLabelText(this.post1CircleName)).fontSize(11).fontColor(0xFF7E8CA8).layoutWeight(1).maxLines(1).textOverflow(TextOverflow.Ellipsis) }.width(100.percent).alignItems(VerticalAlign.Center)
                                        Text(this.postStatsText(this.post1LikeCount, this.post1CommentCount)).fontSize(11).fontColor(0xFF9AA6BD).margin(top: 6)
                                    }.width(100.percent).padding(left: 8, right: 8, top: 8, bottom: 10).backgroundColor(0xFFFFFFFF).borderRadius(16).margin(bottom: 10).onClick({ _: ClickEvent => this.openCircle(this.post1CircleId, this.post1CircleName) })
                                }

