                            if (this.post9Title != "") { Column { if (this.post9ImageUrl != "") { Image(this.post9ImageUrl).width(100.percent).height(210).objectFit(ImageFit.Cover).borderRadius(14).margin(bottom: 10) }; Text(this.post9Title).fontSize(16).fontWeight(FontWeight.Bold).fontColor(0xFF24324A).margin(bottom: 10); Row { Column {}.width(20).height(20).backgroundColor(0xFFDDEBFF).borderRadius(10).margin(right: 8); Text(this.post9Author + " · " + this.cardLabelText(this.post9CircleName)).fontSize(13).fontColor(0xFF7E8CA8).layoutWeight(1).maxLines(1).textOverflow(TextOverflow.Ellipsis) }.width(100.percent).alignItems(VerticalAlign.Center); Text(this.postStatsText(this.post9LikeCount, this.post9CommentCount)).fontSize(12).fontColor(0xFF9AA6BD).margin(top: 8) }.width(100.percent).padding(16).backgroundColor(0xFFFFFFFF).borderRadius(18).margin(bottom: 12).onClick({ _: ClickEvent => this.openCircle(this.post9CircleId, this.post9CircleName) }) }
                            if (this.post10Title != "") { Column { if (this.post10ImageUrl != "") { Image(this.post10ImageUrl).width(100.percent).height(210).objectFit(ImageFit.Cover).borderRadius(14).margin(bottom: 10) }; Text(this.post10Title).fontSize(16).fontWeight(FontWeight.Bold).fontColor(0xFF24324A).margin(bottom: 10); Row { Column {}.width(20).height(20).backgroundColor(0xFFDDEBFF).borderRadius(10).margin(right: 8); Text(this.post10Author + " · " + this.cardLabelText(this.post10CircleName)).fontSize(13).fontColor(0xFF7E8CA8).layoutWeight(1).maxLines(1).textOverflow(TextOverflow.Ellipsis) }.width(100.percent).alignItems(VerticalAlign.Center); Text(this.postStatsText(this.post10LikeCount, this.post10CommentCount)).fontSize(12).fontColor(0xFF9AA6BD).margin(top: 8) }.width(100.percent).padding(16).backgroundColor(0xFFFFFFFF).borderRadius(18).margin(bottom: 12).onClick({ _: ClickEvent => this.openCircle(this.post10CircleId, this.post10CircleName) }) }

                            Text("最新活动").fontSize(20).fontWeight(FontWeight.Bold).fontColor(0xFF24324A).margin(top: 6, bottom: 12)
                            if (!this.hasAnyEvent()) { Column { Text("还没有活动").fontSize(18).fontWeight(FontWeight.Bold).fontColor(0xFF24324A).margin(bottom: 8); Text("创建活动后会出现在这里。").fontSize(13).fontColor(0xFF6D7B99) }.width(100.percent).padding(16).backgroundColor(0xFFFFFFFF).borderRadius(18).margin(bottom: 12) }

                            if (this.event1Title != "") { Column { Row { Text(this.event1Status).fontSize(11).fontWeight(FontWeight.Bold).fontColor(0xFF2F80FF).backgroundColor(0xFFEAF2FF).padding(left: 8, right: 8, top: 4, bottom: 4).borderRadius(10); Row {}.layoutWeight(1); Text("查看").fontSize(12).fontColor(0xFF9AA6BD) }.width(100.percent).alignItems(VerticalAlign.Center).margin(bottom: 8); Text(this.event1Title).fontSize(18).fontWeight(FontWeight.Bold).fontColor(0xFF24324A).margin(bottom: 8); Text(this.event1Description).fontSize(13).fontColor(0xFF6D7B99).lineHeight(20).maxLines(2).textOverflow(TextOverflow.Ellipsis).margin(bottom: 10); Text(this.event1Time + " · " + this.event1Location).fontSize(12).fontColor(0xFF4E5D78).margin(bottom: 4); Text(this.event1DeadlineText + " · " + this.event1RegisteredText).fontSize(11).fontColor(0xFF7C879C) }.width(100.percent).padding(16).backgroundColor(0xFFFFFFFF).borderRadius(18).margin(bottom: 12).onClick({ _: ClickEvent => this.openEventDetail(this.event1Id, this.event1Title, this.event1Time, this.event1Location, this.event1Status, this.event1Description, this.event1CapacityText, this.event1DeadlineText) }) }
                            if (this.event2Title != "") { Column { Row { Text(this.event2Status).fontSize(11).fontWeight(FontWeight.Bold).fontColor(0xFF2F80FF).backgroundColor(0xFFEAF2FF).padding(left: 8, right: 8, top: 4, bottom: 4).borderRadius(10); Row {}.layoutWeight(1); Text("查看").fontSize(12).fontColor(0xFF9AA6BD) }.width(100.percent).alignItems(VerticalAlign.Center).margin(bottom: 8); Text(this.event2Title).fontSize(18).fontWeight(FontWeight.Bold).fontColor(0xFF24324A).margin(bottom: 8); Text(this.event2Description).fontSize(13).fontColor(0xFF6D7B99).lineHeight(20).maxLines(2).textOverflow(TextOverflow.Ellipsis).margin(bottom: 10); Text(this.event2Time + " · " + this.event2Location).fontSize(12).fontColor(0xFF4E5D78).margin(bottom: 4); Text(this.event2DeadlineText + " · " + this.event2RegisteredText).fontSize(11).fontColor(0xFF7C879C) }.width(100.percent).padding(16).backgroundColor(0xFFFFFFFF).borderRadius(18).margin(bottom: 12).onClick({ _: ClickEvent => this.openEventDetail(this.event2Id, this.event2Title, this.event2Time, this.event2Location, this.event2Status, this.event2Description, this.event2CapacityText, this.event2DeadlineText) }) }
                        }.width(100.percent)
                    }
                }.width(100.percent).padding(left: 12, right: 12, top: 8, bottom: 96)
            }.layoutWeight(1)

            Row {
                Row { Text("广场").fontColor(0xFF2F80FF).fontWeight(FontWeight.Bold).fontSize(15) }.layoutWeight(1).height(40).justifyContent(FlexAlign.Center).alignItems(VerticalAlign.Center)
                Row { Text("圈子").fontColor(0xFF5E6C84).fontSize(15).onClick({ _: ClickEvent => this.goToCirclesPage() }) }.layoutWeight(1).height(40).justifyContent(FlexAlign.Center).alignItems(VerticalAlign.Center)
                Button("+").width(52).height(52).backgroundColor(0xFF2F80FF).fontColor(0xFFFFFFFF).fontSize(28).fontWeight(FontWeight.Bold).borderRadius(26).margin(left: 6, right: 6).onClick({ _: ClickEvent => this.goToCreatePostPage() })
                Row { Text("活动").fontColor(0xFF5E6C84).fontSize(15).onClick({ _: ClickEvent => this.goToEventsPage() }) }.layoutWeight(1).height(40).justifyContent(FlexAlign.Center).alignItems(VerticalAlign.Center)
                Row { Text("我的").fontColor(0xFF5E6C84).fontSize(15).onClick({ _: ClickEvent => this.goToProfilePage() }) }.layoutWeight(1).height(40).justifyContent(FlexAlign.Center).alignItems(VerticalAlign.Center)
            }.alignItems(VerticalAlign.Center).width(100.percent).padding(left: 10, right: 10, top: 10, bottom: 16).backgroundColor(0xFFFFFFFF)
        }.width(100.percent).height(100.percent).backgroundColor(0xFFF4F8FF)
    }
}